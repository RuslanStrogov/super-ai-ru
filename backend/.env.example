# === Super AI RU — Backend Configuration ===

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/super_ai_ru

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- JWT ---
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Providers ---

# YandexGPT
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt/pro

# GigaChat
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat:latest

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# --- App ---
APP_NAME=Super AI RU
DEBUG=true
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=*

# --- Storage (S3-compatible) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=super-ai-ru-documents